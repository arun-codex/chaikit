{
  "name": "@chaikit/react",
  "version": "1.0.0",
  "description": "React wrapper component for ChaiKit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "chaikit",
    "react",
    "buy-me-a-chai",
    "upi",
    "widget"
  ],
  "dependencies": {
    "@chaikit/core": "^1.0.0",
    "@chaikit/widget": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0 || ^18.0.0 || ^19.0.0",
    "react-dom": ">=16.8.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun-codex/chaikit.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/arun-codex/chaikit/issues"
  },
  "homepage": "https://github.com/arun-codex/chaikit#readme"
}
