{
  "name": "@chaikit/core",
  "version": "1.0.0",
  "description": "Core payment, amount math, and validation engine for ChaiKit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "chaikit",
    "upi",
    "core",
    "payment",
    "qr",
    "india"
  ],
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arun-codex/chaikit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/arun-codex/chaikit/issues"
  },
  "homepage": "https://github.com/arun-codex/chaikit#readme"
}
